// THE HELP CENTRE AND THE DESK ON SCREEN — read as a photographer reads them and written as the team writes them: the
// front page, a category, an article (and the same article in Swedish and in Arabic), a search, a search that finds
// nothing, a team article asked for by a photographer, suggestions while typing, and the desk's list, editor, review
// and categories — wide and on a phone, light and dark. `osy test --pixels` photographs each (`Ui.Shot`).
using Osysharp.Identity;
using Osysharp.KnowledgeBase;
using KnowledgeKitTests;

/// Lumen's documentation with something in it: two categories of public articles (one in Swedish and Arabic too), a
/// team playbook, a draft in review and a draft being written.
void Stocked() {
  var raw = Published("installing", "Open RAW files from your camera",
    "## Before you start\n\nLumen opens RAW files from most cameras made since 2012. If a file shows a grey square, your camera may be newer than your copy of Lumen.\n\n## Open a file\n\n1. Choose **File › Open**, or drag the files onto the window.\n2. Lumen reads the RAW data and shows a preview within a second or two.\n3. Edits are kept beside the file — the RAW itself is never changed.\n\n## If it does not open\n\n- Update Lumen: **Lumen › Check for updates**.\n- Check the file opens in your camera maker's own viewer.\n- Still stuck? Send us the file and we will look.\n\n```\nSupported: .CR3 .NEF .ARW .RAF .ORF .DNG\n```",
    summary: "Which cameras Lumen reads, and what to do when a file shows a grey square.");
  Translated(raw, "sv", "Öppna RAW-filer från kameran",
    "## Innan du börjar\n\nLumen öppnar RAW-filer från de flesta kameror som gjorts sedan 2012. Visar en fil en grå ruta kan kameran vara nyare än din version av Lumen.\n\n## Öppna en fil\n\n1. Välj **Arkiv › Öppna**, eller dra filerna till fönstret.\n2. Lumen läser RAW-datan och visar en förhandsvisning inom ett par sekunder.\n3. Ändringar sparas bredvid filen — själva RAW-filen ändras aldrig.",
    summary: "Vilka kameror Lumen läser, och vad du gör när en fil visar en grå ruta.");
  Translated(raw, "ar", "افتح ملفات RAW من الكاميرا",
    "## قبل أن تبدأ\n\nيفتح Lumen ملفات RAW من معظم الكاميرات المصنوعة منذ عام 2012. إذا ظهر الملف كمربع رمادي، فقد تكون الكاميرا أحدث من نسختك من Lumen.\n\n## افتح ملفًا\n\n1. اختر **ملف › فتح**، أو اسحب الملفات إلى النافذة.\n2. يقرأ Lumen بيانات RAW ويعرض معاينة خلال ثانية أو ثانيتين.\n3. تُحفظ التعديلات بجانب الملف — لا يتغير ملف RAW نفسه أبدًا.",
    summary: "ما الكاميرات التي يقرأها Lumen، وماذا تفعل عندما يظهر الملف كمربع رمادي.");
  Published("installing", "Install Lumen on a Mac", "Open the disk image and drag **Lumen** to *Applications*. The first time it opens, macOS asks whether to trust it — choose **Open**.",
            summary: "From the download to the first photo.");
  Published("installing", "Install Lumen on Windows", "Run the installer and follow its steps. Lumen needs Windows 10 or later and 8 GB of memory.",
            summary: "What it needs, and the three steps of the installer.");
  Published("your-account", "Move your licence to a new computer", "Sign out of Lumen on the old computer (**Lumen › Sign out**), then sign in on the new one. A licence is for two computers at a time.",
            summary: "Two computers at a time — sign out on one to use another.");
  Published("colour", "Fix a colour cast with white balance", "Pick the **dropper** above the temperature slider and click something that should be neutral grey — a wall, a shirt, a cloud.",
            summary: "One click on something grey.");
  Published("presets", "Make a preset from an edit", "When an edit looks right, choose **Edit › Save as preset**. It appears under *Presets* for every photo after.",
            summary: "Save a look and use it on every photo after.");
  Published("refunds", "Refund a licence bought in the last 30 days", "Refund it in the payments dashboard, then mail the customer the template *Refund done*. No questions asked within 30 days.",
            summary: "No questions asked within 30 days.");
  runas (Wren) {
    var d = NewKnowledgeArticle(KnowledgeSection.Single(s => s.Slug == "presets"), "Share a preset with a friend");
    d.Summary = "Export it as a file and send it.";
    d.Body = "Right-click the preset and choose **Export**. Send the `.lumenpreset` file; your friend drags it onto Lumen.";
    d.ChangeNote = "First version";
    UnitOfWork.Commit();
    SendKnowledgeForReview(d, "Is the right-click menu the same on Windows?");
    var w = NewKnowledgeArticle(KnowledgeSection.Single(s => s.Slug == "colour"), "Print colours that match the screen");
    w.Body = "Start with a calibrated screen.";
    UnitOfWork.Commit();
  }
  Background.Settle();
}

/// The help centre's frame is its LAYOUT, so it stays on screen between pages: a note typed into Lumen's header on the
/// front page is still there on a category and on an article. A frame drawn inside each page would be a new frame on
/// every page, and the note would be gone.
[Test(Lumen)]
void the_frame_stays_on_screen_between_help_centre_pages() {
  Stocked();
  Ui.Viewport(1440, 900);
  Ui.Visit("/help-centre");
  Ui.Fill("Note", "grey squares on the R5");
  Assert.Visible("Your note: grey squares on the R5");
  Ui.Click("Getting started");
  Assert.Visible("Install Lumen on a Mac");
  Assert.Visible("Your note: grey squares on the R5");
  Ui.Click("Open RAW files from your camera");
  Assert.Visible("Before you start");
  Assert.Visible("Your note: grey squares on the R5");
  Ui.Shot("frame-kept-on-article");
}

