[Test(Lumen)]
void the_doors_into_lumen_let_in_the_right_person() {
  Assert.NotEqual("", SignInWithCode("pia@photos.test", "1234"));
  Assert.Equal("", SignInWithCode("pia@photos.test", "4321"));
  Assert.Equal("", SignInWithCode("nobody@photos.test", "1234"));
}
