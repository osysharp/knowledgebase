/// A knowledge base of hundreds of articles opens on the newest fifty: the list reads a window, and "Show more" reads
/// the next. Searching and the lists still look across all of them, not just the window on screen.
[Test(Lumen)]
void the_desk_shows_the_newest_articles_first_and_the_rest_on_request() {
  TestClock.Set(new DateTime(2030, 3, 2, 9, 0, 0));
  runas (Wren) {
    var presets = KnowledgeSection.Single(s => s.Slug == "presets");
    for (var i = 1; i <= 52; i++) {
      TestClock.Advance(TimeSpan.FromMinutes(1));
      NewKnowledgeArticle(presets, "Shortcut " + (i < 10 ? "0" : "") + i + " for faster editing");
      UnitOfWork.Commit();
    }
  }
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Eda);
  Ui.Visit("/knowledge");
  Assert.Visible("Shortcut 52 for faster editing", within: "Articles");
  Assert.Visible("Shortcut 03 for faster editing", within: "Articles");
  Assert.Hidden("Shortcut 02 for faster editing");
  Assert.Hidden("Shortcut 01 for faster editing");
  // A search looks past the window.
  Ui.Fill("Find an article", "shortcut 01");
  Assert.Visible("Shortcut 01 for faster editing", within: "Articles");
  Ui.Fill("Find an article", "");
  Ui.Click("Show more");
  Assert.Visible("Shortcut 01 for faster editing", within: "Articles");
  Assert.Hidden("Show more");
  Ui.Shot("desk-list-more-wide-light");
}

[Test(Lumen)]
void a_writer_starts_an_article_writes_it_and_sends_it_for_review() {
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Wren);
  Ui.Visit("/knowledge");
  Assert.Visible("No articles yet");
  Ui.Shot("desk-empty-wide-light");
  Ui.Click("New article");
  Ui.Fill("Title", "Crop to a print size");
  Ui.Click("Where it goes");
  Ui.Click("Editing photos › Presets");
  Ui.Shot("desk-new-article-wide-light");
  Ui.Click("Start writing");
  Assert.Visible("Version 1 · yours");
  Ui.Fill("One line about it", "Pick 10×15 or A4 and the crop keeps the shape.");
  Ui.Click("Save");
  Assert.Visible("Saved");
  // An empty article is not sent — the refusal says why, on the draft.
  Ui.Click("Send for review");
  Background.Settle();
  Assert.Visible("Write something first — the article is empty.");
  Ui.Shot("desk-editor-refused-wide-light");
  // Its words (the editor saves them as they are written).
  runas (Wren) {
    var d = KnowledgeRevision.Single(r => r.Title == "Crop to a print size");
    d.Body = "## Pick a size\n\nChoose **Crop** and pick *10×15* or *A4* — the frame keeps that shape as you drag it.\n\n## Turn it\n\nPress **X** to swap portrait and landscape.";
    UnitOfWork.Commit();
  }
  Ui.Visit("/knowledge");
  Ui.Click("Crop to a print size");
  Assert.Visible("Pick a size");
  Ui.Shot("desk-editor-wide-light");
  Ui.Theme("dark");
  Ui.Shot("desk-editor-wide-dark");
  Ui.Theme("light");
  Ui.Click("Send for review");
  Background.Settle();
  Assert.Visible("In review");
  Assert.Visible("Take it back to change it");
  // A version in review is read-only, so its editor offers no Save — there is nothing a writer could change.
  Assert.Visible("Density", within: "Article text");
  Assert.Hidden("Save", within: "Article text");
  Ui.Shot("desk-sent-wide-light");
}

